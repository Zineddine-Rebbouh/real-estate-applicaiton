    "@types/terraformer__wkt": "^2.0.3",
    "@types/uuid": "^11.0.0",
    "concurrently": "^10.0.5",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "shx": "^0.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}
