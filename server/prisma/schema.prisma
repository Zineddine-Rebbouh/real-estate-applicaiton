generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  TENANT
  MANAGER
}

enum PropertyType {
  Rooms
  Tinyhouse
  Apartment
  Villa
  Townhouse
  Cottage
  House
  Condo
  Studio
  Loft
}

enum AmenityEnum {
  WasherDryer
  AirConditioning
  Dishwasher
  HighSpeedInternet
  HardwoodFloors
  WalkInClosets
  Microwave
  Refrigerator
  Pool
  Gym
  Parking
  PetsAllowed
  WiFi
}

enum HighlightEnum {
  HighSpeedInternetAccess
  WasherDryer
  AirConditioning
  Heating
  SmokeFree
  CableReady
  SatelliteTV
  DoubleVanities
  TubShower
  Intercom
  SprinklerSystem
  RecentlyRenovated
  CloseToTransit
  GreatView
  QuietNeighborhood
}

enum ApplicationStatus {
  Pending
  Approved
  Denied
  Withdrawn
}

enum PaymentStatus {
  Pending
  Paid
  PartiallyPaid
  Overdue
}

enum MoveInTimeline {
  ASAP
  Within30Days
  Within90Days
  JustBrowsing
}

// ---------------------------------------------------------------------------
// Auth / identity
// ---------------------------------------------------------------------------

model User {
  id                      String   @id @default(uuid()) @db.Uuid
  email                   String   @unique
  passwordHash            String
  name                    String
  role                    Role     @default(TENANT)
  refreshTokenVersion     Int      @default(0)
  currentRefreshTokenHash String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  // Profile rows — at most one of these exists per User
  manager Manager?
  tenant  Tenant?
}

// ---------------------------------------------------------------------------
// Role profiles
//
// Manager and Tenant extend User rather than duplicating auth fields.
// Each profile is 1:1 with User (enforced by @unique on userId).
// Auth concerns stay in User; domain concerns live in the profile models.
// ---------------------------------------------------------------------------

model Manager {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @db.Uuid
  phoneNumber String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  properties Property[]
}

model Tenant {
  id                    String          @id @default(uuid()) @db.Uuid
  userId                String          @unique @db.Uuid
  phoneNumber           String?
  minBudget             Decimal?        @db.Decimal(10, 2)
  maxBudget             Decimal?        @db.Decimal(10, 2)
  desiredBeds           Int?
  desiredBaths          Int?
  householdSize         Int?
  hasPets               Boolean?
  petType               String?
  needsParking          Boolean?
  moveInTimeline        MoveInTimeline?
  preferredCity         String?
  onboardingCompletedAt DateTime?
  createdAt             DateTime        @default(now())
  updatedAt   DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  leases       Lease[]
  applications Application[]
  favorites    Favorite[]
  reviews      Review[]
  paymentMethods PaymentMethod[]
  maintenanceRequests MaintenanceRequest[]
  tourRequests TourRequest[]
  contactMessages ContactMessage[]
}

// ---------------------------------------------------------------------------
// Property
//
// Location fields are embedded (no separate Location table) — every property
// query also needs the address and they are strictly 1:1 with no sharing.
//
// Money fields use Decimal (PostgreSQL NUMERIC) to avoid floating-point drift.
//
// Amenities and highlights are stored as enum arrays — always fetched whole,
// the set of valid values is fixed, so a junction table adds no value.
// ---------------------------------------------------------------------------

model Property {
  id                String        @id @default(uuid()) @db.Uuid
  managerId         String        @db.Uuid

  // Core listing fields
  name              String
  description       String
  pricePerMonth     Decimal       @db.Decimal(10, 2)
  securityDeposit   Decimal       @db.Decimal(10, 2)
  applicationFee    Decimal       @db.Decimal(10, 2)
  photoUrls         String[]
  amenities         AmenityEnum[]
  highlights        HighlightEnum[]
  isPetsAllowed     Boolean       @default(false)
  isParkingIncluded Boolean       @default(false)
  beds              Int
  baths             Int
  squareFeet        Int
  propertyType      PropertyType
  postedDate        DateTime      @default(now())

  // Optional coordinates — plain numeric fields, no PostGIS.
  // Map rendering off these is a follow-up; nothing else depends on them.
  latitude          Float?
  longitude         Float?

  // Availability
  availableFrom     DateTime?

  // Embedded location (replaces the old separate Location table)
  address           String
  city              String
  state             String
  country           String
  postalCode        String

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  manager           Manager       @relation(fields: [managerId], references: [id])
  leases            Lease[]
  applications      Application[]
  favorites         Favorite[]
  reviews           Review[]
  maintenanceRequests MaintenanceRequest[]
  tourRequests      TourRequest[]
  contactMessages   ContactMessage[]
}

// ---------------------------------------------------------------------------
// Lease
// ---------------------------------------------------------------------------

model Lease {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  tenantId   String   @db.Uuid
  startDate  DateTime
  endDate    DateTime
  rent       Decimal  @db.Decimal(10, 2)
  deposit    Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property     Property      @relation(fields: [propertyId], references: [id])
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  payments     Payment[]
  applications Application[]
  maintenanceRequests MaintenanceRequest[]
}

// ---------------------------------------------------------------------------
// Application
//
// Contact fields (name, email, phoneNumber) are intentionally denormalized:
// an application is a point-in-time snapshot of what was submitted.
// Changing a tenant profile later must not retroactively alter applications.
// ---------------------------------------------------------------------------

model Application {
  id              String            @id @default(uuid()) @db.Uuid
  propertyId      String            @db.Uuid
  tenantId        String            @db.Uuid
  leaseId         String?           @db.Uuid
  applicationDate DateTime          @default(now())
  status          ApplicationStatus @default(Pending)

  // Snapshot of applicant contact info at submission time
  name            String
  email           String
  phoneNumber     String
  message         String?

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  property        Property          @relation(fields: [propertyId], references: [id])
  tenant          Tenant            @relation(fields: [tenantId], references: [id])
  lease           Lease?            @relation(fields: [leaseId], references: [id])
}

// ---------------------------------------------------------------------------
// Payment
//
// Linked to a Lease (not directly to Property or Tenant) because a payment
// is always made against a specific lease agreement.
// ---------------------------------------------------------------------------

model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  leaseId       String        @db.Uuid
  amountDue     Decimal       @db.Decimal(10, 2)
  amountPaid    Decimal       @db.Decimal(10, 2)
  dueDate       DateTime
  paymentDate   DateTime?
  paymentStatus PaymentStatus @default(Pending)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  lease         Lease         @relation(fields: [leaseId], references: [id])
}

// ---------------------------------------------------------------------------
// Review
//
// One review per tenant per property (@@unique). Rating only makes sense
// from someone who has actually held a lease there — enforced in the
// review controller (application logic), not as a DB rule.
// Property-level averages/counts are computed from these rows on read;
// nothing is denormalized onto Property.
// ---------------------------------------------------------------------------

model Review {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  tenantId   String   @db.Uuid
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([propertyId, tenantId])
}

// ---------------------------------------------------------------------------
// ManagerInviteCode
//
// Signing up as MANAGER requires a valid, unused code. Codes are minted
// out-of-band (prisma/generate-invite-codes.ts); consuming one stamps
// usedAt/usedByUserId so it cannot be reused.
// ---------------------------------------------------------------------------

model ManagerInviteCode {
  id            String    @id @default(uuid()) @db.Uuid
  code          String    @unique
  usedAt        DateTime?
  usedByUserId  String?   @db.Uuid
  createdAt     DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// Favorite
//
// Explicit join table (not implicit Prisma m2m) so we can store createdAt —
// needed to sort a tenant's favorites list by when they were saved.
// @@unique prevents double-favoriting the same property.
// ---------------------------------------------------------------------------

model Favorite {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  propertyId String   @db.Uuid
  createdAt  DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([tenantId, propertyId])
}

enum PaymentMethodType {
  Card
  Bank
}

// ---------------------------------------------------------------------------
// PaymentMethod
//
// Reference-only vault: brand/last4/expiry/holder plus gateway ids for a
// future processor. Full PANs, CVCs, and IBANs must NEVER be sent here —
// the client derives references locally and discards the rest. No charging
// happens off this table until a gateway is integrated.
// ---------------------------------------------------------------------------

model PaymentMethod {
  id                     String            @id @default(uuid()) @db.Uuid
  tenantId               String            @db.Uuid
  type                   PaymentMethodType
  brand                  String?
  last4                  String
  expMonth               Int?
  expYear                Int?
  accountHolder          String
  gatewayCustomerId      String?
  gatewayPaymentMethodId String?
  isDefault              Boolean           @default(false)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

enum MaintenanceStatus {
  Open
  InProgress
  Resolved
}

// ---------------------------------------------------------------------------
// MaintenanceRequest
//
// Tenant-reported issue on a property. leaseId snapshots the tenant's
// current lease on that property at report time (nullable — a tenant may
// report without an active lease) for manager context.
// ---------------------------------------------------------------------------

model MaintenanceRequest {
  id          String            @id @default(uuid()) @db.Uuid
  propertyId  String            @db.Uuid
  tenantId    String            @db.Uuid
  leaseId     String?           @db.Uuid
  title       String
  description String
  status      MaintenanceStatus @default(Open)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  property Property @relation(fields: [propertyId], references: [id])
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lease    Lease?   @relation(fields: [leaseId], references: [id])
}

enum TourType {
  InPerson
  Video
}

enum TourStatus {
  Pending
  Confirmed
  Declined
}

// ---------------------------------------------------------------------------
// TourRequest + ContactMessage
//
// Persist exactly what the listing modals collect: tour type + the
// preferred slot labels as picked (no fake date parsing) + note, and free
// text messages. Contact snapshots come from the session, not the form.
// Tenants have no history surface yet — the manager queue is the reader.
// ---------------------------------------------------------------------------

model TourRequest {
  id            String     @id @default(uuid()) @db.Uuid
  propertyId    String     @db.Uuid
  tenantId      String     @db.Uuid
  name          String
  email         String
  tourType      TourType
  preferredDate String
  preferredTime String
  note          String?
  status        TourStatus @default(Pending)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  property Property @relation(fields: [propertyId], references: [id])
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model ContactMessage {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  tenantId   String   @db.Uuid
  name       String
  email      String
  message    String
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id])
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}
