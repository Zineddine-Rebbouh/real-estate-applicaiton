# Habitat Client — Environment Variables
# Copy this file to .env.local and fill in the values.

# Backend API base URL (Next.js app fetches property data from here)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3002

# --- Google Maps ---------------------------------------------------------------
# Both values are required for the live Google Maps to render on the Explore
# page and listing detail pages. Without them the app falls back to the custom
# SVG map automatically — nothing breaks.
#
# 1. Create a project at https://console.cloud.google.com
# 2. Enable "Maps JavaScript API" under APIs & Services > Library
# 3. Create an API Key under APIs & Services > Credentials
#    (restrict it to your domain in production)
# 4. Create a Map ID under Google Maps Platform > Map Management > Create Map ID
#    (Type: JavaScript, Rendering type: Raster or Vector — either works)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
